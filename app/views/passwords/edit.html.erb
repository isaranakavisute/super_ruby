<% content_for :title, "Update your password" %>

<div class="w-full max-w-sm rounded-xl bg-white p-8 shadow-md">
  <h1 class="mb-5 text-2xl font-bold">Update your password</h1>

  <%= render "shared/flash" %>

  <%= form_with url: password_path(params[:token]), method: :put, class: "grid gap-4" do |form| %>
    <div class="grid gap-1.5">
      <%= form.label :password, "New password", class: "text-sm font-semibold" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72,
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-transparent focus:outline-2 focus:outline-blue-600" %>
    </div>

    <div class="grid gap-1.5">
      <%= form.label :password_confirmation, "Repeat new password", class: "text-sm font-semibold" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72,
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-transparent focus:outline-2 focus:outline-blue-600" %>
    </div>

    <%= form.submit "Save", class: "w-full cursor-pointer rounded-lg bg-blue-600 py-2.5 font-semibold text-white hover:bg-blue-700" %>
  <% end %>
</div>
