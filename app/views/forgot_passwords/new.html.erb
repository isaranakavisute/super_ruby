<% content_for :title, "Forgot password" %>

<div class="w-full max-w-sm rounded-xl bg-white p-8 shadow-md">
  <h1 class="mb-2 text-2xl font-bold">Forgot password</h1>
  <p class="mb-5 text-sm text-gray-500">Enter your username. The admin will reset your password and let you know the new one.</p>

  <%= render "shared/flash" %>

  <%= form_with url: forgot_password_path, class: "grid gap-4" do |form| %>
    <div class="grid gap-1.5">
      <%= form.label :username, class: "text-sm font-semibold" %>
      <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", autocapitalize: "none", placeholder: "Enter your username", value: params[:username],
            aria: { invalid: @error.present?, describedby: ("forgot-error" if @error) },
            class: ["w-full rounded-lg border px-3 py-2 focus:border-transparent focus:outline-2 focus:outline-blue-600", @error ? "border-red-500" : "border-gray-300"] %>
      <%= tag.p(@error, class: "text-sm text-red-600", id: "forgot-error") if @error %>
    </div>

    <%= form.submit "Send request", class: "w-full cursor-pointer rounded-lg bg-blue-600 py-2.5 font-semibold text-white hover:bg-blue-700" %>
  <% end %>

  <p class="mt-4 text-center text-sm">
    <%= link_to "← Back to sign in", login_path, class: "text-blue-600 hover:underline" %>
  </p>
</div>
