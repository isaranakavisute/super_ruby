<% content_for :title, "Set up two-factor authentication" %>

<div class="w-full max-w-md rounded-xl bg-white p-8 shadow-md">
  <h1 class="mb-2 text-2xl font-bold">Set up two-factor authentication</h1>
  <p class="mb-5 text-sm text-gray-500">
    To protect your account, every sign-in needs a code from an authenticator app on your phone, as well as your password.
  </p>

  <%= render "shared/flash" %>

  <ol class="mb-5 grid list-decimal gap-3 pl-5 text-sm">
    <li>Open <strong>Microsoft Authenticator</strong> on your phone (or another authenticator app).</li>
    <li>Tap <strong>+</strong>, then <strong>Other account (Google, Facebook, etc.)</strong>, and scan this QR code:</li>
  </ol>

  <div class="mb-3 flex justify-center">
    <div class="size-48 rounded-lg border border-gray-200 p-2 [&>svg]:size-full" role="img" aria-label="QR code for your authenticator app"><%= @qr_svg.html_safe %></div>
  </div>

  <details class="mb-5 text-sm">
    <summary class="cursor-pointer text-blue-600 hover:underline">Can't scan it? Enter the key instead</summary>
    <p class="mt-2 text-gray-600">In the app choose <strong>Enter code manually</strong>, with account name <strong><%= @account.myuser %></strong> and this key:</p>
    <p class="mt-1 rounded-lg bg-gray-100 px-3 py-2 text-center font-mono tracking-wider" data-testid="otp-secret"><%= @secret.scan(/.{1,4}/).join(" ") %></p>
  </details>

  <%= form_with url: two_factor_setup_path, class: "grid gap-4" do |form| %>
    <div class="grid gap-1.5">
      <%= form.label :code, "3. Enter the 6-digit code shown in the app", class: "text-sm font-semibold" %>
      <%= render "two_factor/code_field", form: form, error: @error, placeholder: "123456" %>
    </div>

    <%= form.submit "Turn on two-factor authentication", class: "w-full cursor-pointer rounded-lg bg-blue-600 py-2.5 font-semibold text-white hover:bg-blue-700" %>
  <% end %>

  <p class="mt-4 text-center text-sm">
    <%= link_to "← Back to sign in", login_path, class: "text-blue-600 hover:underline" %>
  </p>
</div>
