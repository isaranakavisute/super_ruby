<% content_for :title, "MyShop" %>
<% content_for :full_width, true %>

<header class="bg-gradient-to-b from-[#f53d2d] to-[#f63] text-white">
  <div class="mx-auto flex max-w-6xl items-center justify-end gap-4 px-4 py-1.5 text-xs">
    <span>👤 <%= Current.user.username || Current.user.email_address %></span>
    <%= button_to "Sign out", login_path, method: :delete, form_class: "inline", class: "cursor-pointer hover:underline" %>
  </div>

  <div class="mx-auto flex max-w-6xl items-center gap-6 px-4 pb-4 pt-2">
    <%= link_to root_path, class: "flex shrink-0 items-center gap-2 text-2xl font-bold" do %>
      🛍️ <span>MyShop</span>
    <% end %>

    <%= form_with url: root_path, method: :get, class: "flex flex-1 rounded-sm bg-white p-1" do |form| %>
      <%= form.search_field :q, value: @query, placeholder: "Search for products", "aria-label": "Search for products",
            class: "min-w-0 flex-1 px-3 text-sm text-gray-900 outline-none" %>
      <%= form.hidden_field :category, value: @category if @category %>
      <%= form.button "🔍", name: nil, class: "cursor-pointer rounded-sm bg-[#fb5533] px-5 py-1.5 hover:bg-[#f53d2d]", "aria-label": "Search" %>
    <% end %>

    <span class="relative shrink-0 text-2xl" title="Cart">
      🛒
      <span class="absolute -right-2.5 -top-1.5 rounded-full border-2 border-[#f63] bg-white px-1.5 text-xs font-semibold text-[#ee4d2d]">3</span>
    </span>
  </div>
</header>

<main class="mx-auto max-w-6xl space-y-4 px-4 py-5">
  <%= render "shared/flash" %>

  <%# Categories %>
  <nav class="grid grid-cols-4 gap-2 rounded-sm bg-white p-3 text-center text-xs shadow-sm sm:grid-cols-7">
    <% ([ nil ] + Product::CATEGORIES).each do |category| %>
      <%= link_to root_path(category: category, q: @query.presence),
            class: ["flex flex-col items-center gap-1 rounded p-2 hover:bg-orange-50",
                    ("bg-orange-50 font-semibold text-[#ee4d2d]" if category == @category)] do %>
        <span class="text-2xl"><%= category ? ProductsHelper::CATEGORY_ICONS[category] : "🏪" %></span>
        <%= category || "All" %>
      <% end %>
    <% end %>
  </nav>

  <% if @query.blank? && @category.nil? %>
    <%# Promo banner %>
    <section class="grid gap-2 sm:grid-cols-3">
      <div class="flex flex-col justify-center rounded-sm bg-gradient-to-r from-[#ee4d2d] to-orange-400 p-6 text-white sm:col-span-2">
        <p class="text-sm font-semibold uppercase tracking-wide">9.9 Super Shopping Day</p>
        <p class="mt-1 text-3xl font-bold">Up to 70% off</p>
        <p class="mt-2 text-sm">Free shipping on orders over ฿199 🚚</p>
      </div>
      <div class="grid gap-2">
        <div class="rounded-sm bg-yellow-300 p-4 font-semibold text-[#ee4d2d]">🎟️ Collect ฿100 vouchers</div>
        <div class="rounded-sm bg-emerald-500 p-4 font-semibold text-white">💳 Extra 10% cashback</div>
      </div>
    </section>

    <%# Flash sale %>
    <% if @flash_sale.any? %>
      <section class="rounded-sm bg-white p-4 shadow-sm">
        <div class="mb-3 flex items-center gap-3">
          <h2 class="text-lg font-bold italic text-[#ee4d2d]">⚡ FLASH SALE</h2>
          <span class="rounded-sm bg-gray-900 px-1.5 py-0.5 font-mono text-sm text-white">02 : 14 : 37</span>
        </div>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
          <%= render partial: "products/product", collection: @flash_sale %>
        </div>
      </section>
    <% end %>
  <% end %>

  <%# Product grid %>
  <section>
    <h2 class="mb-3 border-b-4 border-[#ee4d2d] bg-white px-4 py-3 text-center font-semibold uppercase text-[#ee4d2d]">
      <% if @query.present? %>
        Results for "<%= @query %>"<%= " in #{@category}" if @category %>
      <% else %>
        <%= @category || "Daily Discover" %>
      <% end %>
    </h2>

    <% if @products.any? %>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
        <%= render partial: "products/product", collection: @products %>
      </div>
    <% else %>
      <div class="rounded-sm bg-white p-10 text-center text-gray-500">
        <p class="text-4xl">🔎</p>
        <p class="mt-2">No products found. Try a different search.</p>
      </div>
    <% end %>
  </section>
</main>
