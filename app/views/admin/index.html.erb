<%= render layout: "admin/shell", locals: { active: :users } do %>
  <section class="rounded-lg bg-white p-6 shadow-sm"
           data-controller="admin-users" data-admin-users-url-value="<%= user_path %>"
           data-admin-users-reset-url-value="<%= admin_reset_password_path(id: "__ID__") %>"
           data-admin-users-reset-password-value="<%= AdminController::RESET_PASSWORD %>"
           data-admin-users-update-url-value="<%= admin_user_path(id: "__ID__") %>">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2 class="text-lg font-semibold">Users</h2>
      <p class="text-sm text-gray-500" data-admin-users-target="status" aria-live="polite"></p>
    </div>

    <table class="w-full border-collapse border border-black text-left text-sm">
      <thead class="bg-gray-100">
        <tr>
          <th class="border border-black px-3 py-2">ID</th>
          <th class="border border-black px-3 py-2">Username</th>
          <th class="border border-black px-3 py-2">Password</th>
          <th class="border border-black px-3 py-2 text-center">Actions</th>
        </tr>
      </thead>
      <tbody data-admin-users-target="body"></tbody>
    </table>

    <%# Edit dialog, opened by a row's pencil button (admin-users#edit). showModal() centres it and dims the page. %>
    <dialog data-admin-users-target="dialog" aria-labelledby="edit-user-title"
            class="m-auto w-full max-w-sm rounded-xl bg-white p-8 shadow-xl backdrop:bg-black/50">
      <h2 id="edit-user-title" class="mb-5 text-xl font-bold">Edit user</h2>

      <%= form_with url: "#", method: :patch, data: { turbo: false, action: "submit->admin-users#save" }, class: "grid gap-4" do |form| %>
        <div class="grid gap-1.5">
          <span class="text-sm font-semibold">ID</span>
          <span class="rounded-lg bg-gray-100 px-3 py-2 text-gray-600" data-admin-users-target="editId"></span>
        </div>

        <div class="grid gap-1.5">
          <%= form.label :myuser, "Username", class: "text-sm font-semibold" %>
          <%= form.text_field :myuser, required: true, maxlength: 50, autocomplete: "off", autocapitalize: "none",
                data: { admin_users_target: "editUsername" },
                class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-transparent focus:outline-2 focus:outline-blue-600" %>
          <p class="hidden text-sm text-red-600" id="edit-username-error" data-admin-users-target="usernameError"></p>
        </div>

        <div class="grid gap-1.5">
          <%= form.label :mypassword, "Password", class: "text-sm font-semibold" %>
          <%= render "shared/password_field", form: form, name: :mypassword, placeholder: "At least 6 characters", autocomplete: "new-password" %>
          <p class="hidden text-sm text-red-600" id="edit-password-error" data-admin-users-target="passwordError"></p>
        </div>

        <p class="hidden text-sm text-red-600" data-admin-users-target="dialogError"></p>

        <div class="mt-2 flex gap-2">
          <button type="button" data-action="admin-users#closeEditor"
                  class="flex-1 cursor-pointer rounded-lg border border-gray-300 py-2.5 font-semibold hover:bg-gray-50">Cancel</button>
          <%= form.submit "Save", data: { admin_users_target: "saveButton" },
                class: "flex-1 cursor-pointer rounded-lg bg-blue-600 py-2.5 font-semibold text-white hover:bg-blue-700 disabled:cursor-wait disabled:opacity-50" %>
        </div>
      <% end %>
    </dialog>
  </section>
<% end %>
