<% content_for :title, "Admin Panel" %>
<% content_for :full_width, true %>

<header class="bg-gray-900 text-white">
  <div class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-4 py-4">
    <h1 class="text-xl font-bold">🛠️ Admin Panel</h1>
    <div class="flex items-center gap-4 text-sm">
      <span>👤 <%= Current.user.username %></span>
      <%= link_to "Shop", root_path, class: "hover:underline" %>
      <%= button_to "Sign out", login_path, method: :delete, form_class: "inline", class: "cursor-pointer hover:underline" %>
    </div>
  </div>
</header>

<main class="mx-auto max-w-4xl px-4 py-6">
  <section class="rounded-lg bg-white p-6 shadow-sm"
           data-controller="admin-users" data-admin-users-url-value="<%= user_path %>">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2 class="text-lg font-semibold">Users</h2>
      <p class="text-sm text-gray-500" data-admin-users-target="status" aria-live="polite"></p>
    </div>

    <table class="w-full border-collapse border border-black text-left text-sm">
      <thead class="bg-gray-100">
        <tr>
          <th class="border border-black px-3 py-2">ID</th>
          <th class="border border-black px-3 py-2">Username</th>
          <th class="border border-black px-3 py-2">Password</th>
        </tr>
      </thead>
      <tbody data-admin-users-target="body"></tbody>
    </table>
  </section>
</main>
