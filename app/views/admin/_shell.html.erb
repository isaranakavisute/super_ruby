<%# Admin Panel frame: header, left menu and the right panel (the block).
    Use: render layout: "admin/shell", locals: { active: :users } do ... end %>
<% content_for :title, "Admin Panel" %>
<% content_for :full_width, true %>

<%# Column: header on top, then the two panels filling the rest of the screen height %>
<div class="flex min-h-screen flex-col">
  <header class="bg-gray-900 text-white">
    <div class="flex items-center justify-between gap-4 px-6 py-4">
      <h1 class="text-xl font-bold">🛠️ Admin Panel</h1>
      <div class="flex items-center gap-4 text-sm">
        <span>👤 <%= Current.user.username %></span>
        <%= link_to "Shop", root_path, class: "hover:underline" %>
        <%= button_to "Sign out", login_path, method: :delete, form_class: "inline", class: "cursor-pointer hover:underline" %>
      </div>
    </div>
  </header>

  <%# Row: left menu (fixed width) and right panel (the remaining width) %>
  <div class="flex flex-1 flex-row">
    <nav class="w-48 shrink-0 bg-gray-800 p-3" aria-label="Admin menu">
      <ul class="grid gap-1">
        <% [ [ "USER", admin_panel_path, :users, "👥" ], [ "PRODUCT", admin_products_path, :products, "📦" ] ].each do |label, path, key, icon| %>
          <li>
            <%= link_to path, aria: { current: ("page" if active == key) },
                  class: ["flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold tracking-wide",
                          active == key ? "bg-white text-gray-900" : "text-gray-300 hover:bg-gray-700 hover:text-white"] do %>
              <span aria-hidden="true"><%= icon %></span> <%= label %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>

    <main class="min-w-0 flex-1 border-l-4 border-sky-200 bg-sky-50 p-6">
      <%= yield %>
    </main>
  </div>
</div>
