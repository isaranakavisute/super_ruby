# Template for the PostgreSQL connection used by PostgresRecord models (see config/database.yml).
#
# Copy to the file for the environment you want to configure:
#   .env.development  -> bin/rails server, bin/rails console
#   .env.test         -> bin/rails test
#   .env.production   -> RAILS_ENV=production, or on the server: docker run --env-file .env.production
#
# Real environment variables always win over these files. Write values without quotes,
# so the same file also works with docker run --env-file.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Optional: prefer (default), require, verify-full, disable
POSTGRES_SSLMODE=prefer
